# Indigo Decors panel — required environment variables.
# Copy to .env.local for development. In production these are injected by
# Coolify in the resource's "Environment Variables" panel.

# Odoo backend (JSON-RPC)
ODOO_URL=http://2.25.137.220:8069
ODOO_DB=indigo-prod
ODOO_TIMEOUT_MS=30000

# Session cookie — name is shared between Next + Odoo's session_id.
SESSION_COOKIE_NAME=indigo_session
# HMAC key for the signed session cookies. REQUIRED, minimum 32 characters —
# the app refuses to read or write a session without it rather than falling
# back to unsigned. Rotate per environment; rotating signs everyone out.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
