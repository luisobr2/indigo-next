# Indigo Decors panel — required environment variables.
# Copy to .env.local for development. In production these are injected by
# Coolify in the resource's "Environment Variables" panel.

# Odoo backend (JSON-RPC)
# NOTE: the values below point at the PRODUCTION Odoo instance (they're
# already committed elsewhere in the repo, so nothing new is exposed by
# keeping them here as the example default). For local development or a
# feature branch, point ODOO_URL/ODOO_DB at a local or staging Odoo instead
# — don't develop against production.
ODOO_URL=http://2.25.137.220:8069
ODOO_DB=indigo-prod
ODOO_TIMEOUT_MS=30000

# Session cookie — name is shared between Next + Odoo's session_id.
SESSION_COOKIE_NAME=indigo_session
# HMAC key for the signed session cookies. REQUIRED, minimum 32 characters —
# the app refuses to read or write a session without it rather than falling
# back to unsigned. Rotate per environment; rotating signs everyone out.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Whether the session cookie carries the `Secure` flag. Defaults to true
# when NODE_ENV=production, false otherwise — override with "false"/"0" or
# "true"/"1" only for an HTTP-only origin (e.g. the Coolify sslip.io URL
# before DNS + SSL are wired). Setting Secure on a plain-HTTP origin makes
# the browser silently drop the cookie: a login that looks successful
# immediately bounces back to /login. See src/lib/odoo/session.ts.
COOKIE_SECURE=

# Public iCalendar feed (/api/calendar.ics) auth — REQUIRED in production.
# Calendar clients (Google/Apple) can't carry the session cookie, so this
# unguessable token in the subscribe URL IS the auth. Left unset, the code
# falls back to a hardcoded default baked into the repo — anyone who can
# read the source can then subscribe to the feed. See src/lib/ics-feed.ts.
CALENDAR_ICS_TOKEN=

# Odoo service account the calendar feed authenticates as (no user session
# is available to an external calendar client). Both REQUIRED in
# production. Left unset, the code falls back to a hardcoded login/password
# baked into the repo. See src/app/api/calendar.ics/route.ts.
ICS_SERVICE_LOGIN=
IMPERSONATE_PASSWORD=

# Public-facing base URL used to build absolute storefront links (e.g. the
# "View on web" button on a design). Optional — falls back to Odoo's own
# web.base.url config param, then to ODOO_URL. See src/lib/odoo/public-url.ts.
PUBLIC_SITE_URL=

# Kill switch for the remote MCP server (/api/mcp) — read-only tools over
# Odoo data for internal agents (Claude Desktop, etc.), gated separately
# from the session-cookie login by its own bearer token (an Odoo
# login.apiKey pair) and an internal-user group check. Defaults to OFF:
# must be the literal string "true" to expose the endpoint, so turning it
# on in production is a deliberate act, not a side effect of merging /
# deploying. See src/app/api/mcp/route.ts.
MCP_ENABLED=
